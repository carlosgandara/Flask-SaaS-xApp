# Copy this file to .env and fill in your private credentials there.
# Never commit .env. This example must contain no real credentials or account IDs.

# AUTHENTICATION (required)
# Generate a random secret (at least 32 bytes):
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# NEON / POSTGRESQL
# Paste the connection string from your Neon project's Connect dialog.
# Example format only (replace every placeholder, keep SSL enabled):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Leaving this blank uses local SQLite for development, not Neon.
DATABASE_URL=

# BREVO TRANSACTIONAL EMAIL (SMTP, required for verification/password reset)
# Brevo Settings > SMTP & API > SMTP contains the login and SMTP key.
# EMAIL_HOST: Brevo's SMTP server; set smtp-relay.brevo.com in your private .env.
EMAIL_HOST=
# Port 587 uses STARTTLS with the current mail service. Do not use SSL-only 465.
EMAIL_PORT=587
# EMAIL_USER: your Brevo SMTP login, which can differ from your account email.
EMAIL_USER=
# EMAIL_PASS: your Brevo SMTP key, not your Brevo API key or account password.
EMAIL_PASS=
# EMAIL_FROM: an email address configured as a sender in Brevo.
EMAIL_FROM=
# Display name recipients see in the From header; not a credential.
EMAIL_DISPLAY_NAME=MyApp

# APPLICATION URL AND COOKIES
# production enables strict HTTPS, PostgreSQL and Redis deployment checks.
APP_ENV=development
# Trust forwarded client IP/protocol only behind this many controlled proxies.
# Keep backend access private when enabling this; default trusts none.
TRUSTED_PROXY_HOPS=0
# The browser origin must match BASE_URL (localhost and 127.0.0.1 differ).
# Used for email links, checkout return URLs, and billing Origin validation.
BASE_URL=http://localhost:5000
# Set True for production HTTPS. False is for local HTTP development only.
COOKIE_SECURE=False

# OPTIONAL BILLING
# Keep disabled until provider credentials, plans, tables, and webhooks are ready.
BILLING_ENABLED=false
# test or live. Use separate test/live credentials, IDs, and databases.
BILLING_MODE=test
# JSON on ONE line, wrapped in single quotes. The plan key is local to this app.
# product_id means Lemon Squeezy VARIANT ID or Stripe recurring PRICE ID.
# Public display prices should match the provider's actual pricing.
BILLING_PLANS='{}'
# Lemon Squeezy plan example (replace VARIANT_ID; do not paste a product ID):
# BILLING_PLANS='{"monthly":{"name":"Monthly membership","description":"Access to paid features","price_label":"$9.99/month","provider":"lemonsqueezy","product_id":"VARIANT_ID"}}'
# Stripe plan example (replace price_REPLACE):
# BILLING_PLANS='{"monthly":{"name":"Monthly membership","description":"Access to paid features","price_label":"$9.99/month","provider":"stripe","product_id":"price_REPLACE"}}'

# LEMON SQUEEZY (required only when a plan uses this provider)
# API key generated in the same test/live mode as BILLING_MODE.
LEMONSQUEEZY_API_KEY=
# Numeric store ID; NOT the store name, product ID, or variant ID.
LEMONSQUEEZY_STORE_ID=
# Same signing secret in .env and your Lemon Squeezy webhook settings.
# Generate exactly 32 characters: python -c "import secrets; print(secrets.token_hex(16))"
# Must be 32-40 characters. This is separate from the API key.
LEMONSQUEEZY_WEBHOOK_SECRET=
# Webhook callback: https://YOUR-PUBLIC-HOST/billing/webhooks/lemonsqueezy

# STRIPE (required only when a plan uses this provider)
# sk_test_... for test mode; sk_live_... for live mode.
STRIPE_SECRET_KEY=
# whsec_... signing secret from the webhook destination or local Stripe CLI.
STRIPE_WEBHOOK_SECRET=
# Webhook callback: https://YOUR-PUBLIC-HOST/billing/webhooks/stripe

# SHARED RATE LIMITS
# Local development only. Live billing requires a provisioned Redis service.
# Production example: rediss://default:PASSWORD@HOST:PORT/0
RATELIMIT_STORAGE_URI=memory://

# NGROK (local testing only)
# Your account-assigned fixed hostname, without https:// or a path.
# Run: .venv/Scripts/python.exe scripts/start_ngrok.py
NGROK_DOMAIN=
# This Flask app does NOT read an NGROK_AUTHTOKEN setting or start ngrok.
# Configure the ngrok CLI separately; its token belongs in ngrok's configuration.
# Never put an actual ngrok token in this example file.

# BILLING WORKER (separate process; same database and credentials as the web app)
# Idle poll interval in seconds (1-60).
BILLING_POLL_SECONDS=2
# Provider reconciliation interval, at least 60 seconds.
BILLING_RECONCILE_SECONDS=900
# Remove completed minimized event payloads after this many days (1-365).
# Deduplication receipts and event identities remain; failed/review payloads remain.
BILLING_EVENT_RETENTION_DAYS=30
